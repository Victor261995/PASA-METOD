# Archivos de Sistema y Sistema Operativo
.DS_Store
Thumbs.db
*.swp
*.tmp

# Frontend (React + Vite)
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/npm-debug.log*

# Backend (Laravel 11)
backend/.env
backend/.env.backup
backend/vendor/
backend/public/storage
backend/storage/*.key
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
!backend/storage/framework/cache/.gitkeep
!backend/storage/framework/cache/data/.gitkeep
!backend/storage/framework/sessions/.gitkeep
!backend/storage/framework/views/.gitkeep
!backend/storage/logs/.gitkeep
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitkeep

# IDEs y Editores
.idea/
.vscode/
*.suo
*.sln
