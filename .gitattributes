# Normalizar finales de línea a LF para todo el repositorio (cross-platform Windows/Linux/macOS)
* text=auto eol=lf

# Forzar explícitamente LF en archivos de código y configuración
*.php text eol=lf
*.jsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.env* text eol=lf
Dockerfile text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Archivos binarios intactos
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary
